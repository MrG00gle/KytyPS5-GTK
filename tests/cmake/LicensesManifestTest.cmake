# licenses_manifest (task 26.3; Requirements 21.1, 21.4): the licenses-manifest.txt and
# licenses-sources.txt that the configure of BUILD_DIR wrote (cmake/KytyLicenses.cmake).
#   - The manifest starts with LICENSE and Kyty-MIT.txt, then lists <component>/<file> paths, sorted
#     and each once, for exactly the components below (the design's list and the FFmpeg prebuilt
#     archive), each with at least one file; renderdoc and xbyak have a NOTICE.
#   - licenses-sources.txt has one line per manifest path, in the same order. LICENSE and
#     Kyty-MIT.txt come from SOURCE_DIR/LICENSE and SOURCE_DIR/LICENSES/Kyty-MIT.txt. Every copied
#     file exists, has the name it is installed under, and that name starts with LICENSE, LICENCE,
#     COPYING, or NOTICE. Every such file at the root of a component's source directory is listed.
#     An extracted NOTICE is a non-empty run of whole lines of its source file, as many lines as the
#     recorded range.
# Run as
#   cmake -DBUILD_DIR=<build tree> -DSOURCE_DIR=<source tree> -P LicensesManifestTest.cmake
cmake_minimum_required(VERSION 3.22)

foreach(kyty_variable IN ITEMS BUILD_DIR SOURCE_DIR)
	if(NOT DEFINED ${kyty_variable} OR "${${kyty_variable}}" STREQUAL "")
		message(FATAL_ERROR "LicensesManifestTest: ${kyty_variable} is not set")
	endif()
endforeach()
set(kyty_components SDL3 fmt magic_enum nlohmann_json spdlog tracy imgui LibAtrac9 stb renderdoc cpuinfo
	clog xxHash Vulkan-Headers VulkanMemoryAllocator SPIRV-Tools SPIRV-Headers ffmpeg-core opus openxr jsoncpp
	xbyak zydis zycore zstd ZArchive ffmpeg)
set(kyty_notice_components renderdoc xbyak)

set(kyty_manifest_file "${BUILD_DIR}/licenses-manifest.txt")
set(kyty_sources_file "${BUILD_DIR}/licenses-sources.txt")
foreach(kyty_file IN ITEMS "${kyty_manifest_file}" "${kyty_sources_file}")
	if(NOT EXISTS "${kyty_file}")
		message(FATAL_ERROR "LicensesManifestTest: ${kyty_file} is missing (configure ${BUILD_DIR} first)")
	endif()
endforeach()
file(STRINGS "${kyty_manifest_file}" kyty_manifest)
file(STRINGS "${kyty_sources_file}" kyty_sources)

set(kyty_failures "")
list(LENGTH kyty_manifest kyty_manifest_count)
list(LENGTH kyty_sources kyty_sources_count)
if(kyty_manifest_count LESS 3)
	message(FATAL_ERROR "LicensesManifestTest: ${kyty_manifest_file} lists ${kyty_manifest_count} paths")
endif()
list(GET kyty_manifest 0 kyty_first)
list(GET kyty_manifest 1 kyty_second)
if(NOT kyty_first STREQUAL "LICENSE" OR NOT kyty_second STREQUAL "Kyty-MIT.txt")
	string(APPEND kyty_failures "\n  the manifest starts with '${kyty_first}', '${kyty_second}' instead of "
		"LICENSE, Kyty-MIT.txt")
endif()
list(SUBLIST kyty_manifest 2 -1 kyty_component_paths)
set(kyty_sorted "${kyty_component_paths}")
list(SORT kyty_sorted)
list(REMOVE_DUPLICATES kyty_sorted)
if(NOT kyty_sorted STREQUAL kyty_component_paths)
	string(APPEND kyty_failures "\n  the component paths are not sorted or not unique")
endif()
if(NOT kyty_sources_count EQUAL kyty_manifest_count)
	string(APPEND kyty_failures "\n  ${kyty_sources_count} lines in licenses-sources.txt for "
		"${kyty_manifest_count} manifest paths")
endif()

set(kyty_listed_components "")
set(kyty_component_dirs "")
math(EXPR kyty_last "${kyty_manifest_count} - 1")
foreach(kyty_index RANGE ${kyty_last})
	list(GET kyty_manifest ${kyty_index} kyty_path)
	if(kyty_index GREATER_EQUAL kyty_sources_count)
		break()
	endif()
	list(GET kyty_sources ${kyty_index} kyty_line)
	string(REPLACE "|" ";" kyty_fields "${kyty_line}")
	list(LENGTH kyty_fields kyty_field_count)
	list(GET kyty_fields 0 kyty_source_path)
	if(NOT kyty_source_path STREQUAL kyty_path OR NOT (kyty_field_count EQUAL 3 OR kyty_field_count EQUAL 5))
		string(APPEND kyty_failures "\n  licenses-sources.txt line ${kyty_index}: '${kyty_line}' does not "
			"describe ${kyty_path}")
		continue()
	endif()
	list(GET kyty_fields 1 kyty_dir)
	list(GET kyty_fields 2 kyty_from)
	get_filename_component(kyty_name "${kyty_path}" NAME)
	get_filename_component(kyty_from_name "${kyty_from}" NAME)
	if(NOT EXISTS "${kyty_from}" OR IS_DIRECTORY "${kyty_from}")
		string(APPEND kyty_failures "\n  ${kyty_path}: its source ${kyty_from} does not exist")
		continue()
	endif()

	if(kyty_index LESS 2)
		set(kyty_expected_from "${SOURCE_DIR}/LICENSE")
		if(kyty_index EQUAL 1)
			set(kyty_expected_from "${SOURCE_DIR}/LICENSES/Kyty-MIT.txt")
		endif()
		file(REAL_PATH "${kyty_from}" kyty_real_from)
		file(REAL_PATH "${kyty_expected_from}" kyty_real_expected)
		if(NOT kyty_real_from STREQUAL kyty_real_expected)
			string(APPEND kyty_failures "\n  ${kyty_path} is installed from ${kyty_from}, not ${kyty_expected_from}")
		endif()
		continue()
	endif()

	if(NOT kyty_path MATCHES "^([^/]+)/([^/]+)$")
		string(APPEND kyty_failures "\n  ${kyty_path} is not <component>/<file>")
		continue()
	endif()
	set(kyty_component "${CMAKE_MATCH_1}")
	if(NOT kyty_component IN_LIST kyty_listed_components)
		list(APPEND kyty_listed_components "${kyty_component}")
		list(APPEND kyty_component_dirs "${kyty_component}|${kyty_dir}")
	endif()
	if(NOT kyty_name MATCHES "^(LICENSE|LICENCE|COPYING|NOTICE)")
		string(APPEND kyty_failures "\n  ${kyty_path}: the name does not start with LICENSE, LICENCE, "
			"COPYING, or NOTICE")
	endif()
	if(NOT kyty_from_name STREQUAL kyty_name)
		string(APPEND kyty_failures "\n  ${kyty_path} is installed from ${kyty_from}, another name")
	endif()
	if(kyty_field_count EQUAL 5)
		# An extracted NOTICE: whole lines of its source, as many as the recorded range.
		list(GET kyty_fields 3 kyty_notice_source)
		list(GET kyty_fields 4 kyty_lines)
		if(NOT kyty_name STREQUAL "NOTICE" OR NOT kyty_lines MATCHES "^([0-9]+)-([0-9]+)$")
			string(APPEND kyty_failures "\n  ${kyty_path}: bad notice record '${kyty_line}'")
			continue()
		endif()
		math(EXPR kyty_line_count "${CMAKE_MATCH_2} - ${CMAKE_MATCH_1} + 1")
		file(READ "${kyty_from}" kyty_notice_text)
		string(REGEX REPLACE "[^\n]" "" kyty_newlines "${kyty_notice_text}")
		string(LENGTH "${kyty_newlines}" kyty_newline_count)
		string(STRIP "${kyty_notice_text}" kyty_notice_stripped)
		file(READ "${kyty_from}" kyty_notice_hex HEX)
		file(READ "${kyty_notice_source}" kyty_source_hex HEX)
		string(FIND "${kyty_source_hex}" "${kyty_notice_hex}" kyty_position)
		set(kyty_odd 1)
		if(kyty_position GREATER_EQUAL 0)
			math(EXPR kyty_odd "${kyty_position} % 2")
		endif()
		if(kyty_notice_stripped STREQUAL "" OR NOT kyty_odd EQUAL 0)
			string(APPEND kyty_failures "\n  ${kyty_path} is empty or not a byte-for-byte part of "
				"${kyty_notice_source}")
		elseif(NOT kyty_newline_count EQUAL kyty_line_count)
			string(APPEND kyty_failures "\n  ${kyty_path} has ${kyty_newline_count} lines, not the "
				"${kyty_line_count} of lines ${kyty_lines} of ${kyty_notice_source}")
		elseif(kyty_position GREATER 0)
			# It starts at a line start: the byte before it is a newline.
			math(EXPR kyty_before "${kyty_position} - 2")
			string(SUBSTRING "${kyty_source_hex}" ${kyty_before} 2 kyty_before_byte)
			if(NOT kyty_before_byte STREQUAL "0a")
				string(APPEND kyty_failures "\n  ${kyty_path} does not start at a line of ${kyty_notice_source}")
			endif()
		endif()
	endif()
endforeach()

# Exactly the expected components, and the NOTICE where the design asks for one.
foreach(kyty_component IN LISTS kyty_components)
	if(NOT kyty_component IN_LIST kyty_listed_components)
		string(APPEND kyty_failures "\n  no license file for ${kyty_component}")
	endif()
endforeach()
foreach(kyty_component IN LISTS kyty_listed_components)
	if(NOT kyty_component IN_LIST kyty_components)
		string(APPEND kyty_failures "\n  unexpected component ${kyty_component}")
	endif()
endforeach()
foreach(kyty_component IN LISTS kyty_notice_components)
	if(NOT "${kyty_component}/NOTICE" IN_LIST kyty_component_paths)
		string(APPEND kyty_failures "\n  no ${kyty_component}/NOTICE")
	endif()
endforeach()

# Every license file at the root of each component's source directory is listed.
foreach(kyty_entry IN LISTS kyty_component_dirs)
	string(REPLACE "|" ";" kyty_fields "${kyty_entry}")
	list(GET kyty_fields 0 kyty_component)
	list(GET kyty_fields 1 kyty_dir)
	file(GLOB kyty_root_files LIST_DIRECTORIES false "${kyty_dir}/*")
	foreach(kyty_file IN LISTS kyty_root_files)
		get_filename_component(kyty_name "${kyty_file}" NAME)
		if(kyty_name MATCHES "^(LICENSE|LICENCE|COPYING|NOTICE)"
		   AND NOT "${kyty_component}/${kyty_name}" IN_LIST kyty_component_paths)
			string(APPEND kyty_failures "\n  ${kyty_file} is not listed as ${kyty_component}/${kyty_name}")
		endif()
	endforeach()
endforeach()

list(LENGTH kyty_listed_components kyty_component_count)
list(JOIN kyty_manifest "\n  " kyty_manifest_text)
message(STATUS "LicensesManifestTest: ${kyty_manifest_count} paths for ${kyty_component_count} components:\n  "
	"${kyty_manifest_text}")
if(kyty_failures)
	message(FATAL_ERROR "LicensesManifestTest: FAILED:${kyty_failures}")
endif()
list(LENGTH kyty_components kyty_expected_count)
message(STATUS "LicensesManifestTest: PASS (LICENSE, Kyty-MIT.txt, and ${kyty_expected_count} components)")
