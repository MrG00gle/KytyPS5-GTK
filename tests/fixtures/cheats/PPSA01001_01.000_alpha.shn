<?xml version="1.0" encoding="utf-8"?>
<!-- A trainer in the SHN format for the tests' Alpha Game, written for Kyty's tests. -->
<Trainer Game="Alpha Game" Moder="Kyty Tests" Cusa="PPSA01001" Version="01.000" Process="eboot.bin">
