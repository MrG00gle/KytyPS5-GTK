      <Offset>0x4D5E</Offset>
      <Section>0</Section>
      <ValueOn>FF-FF</ValueOn>
      <ValueOff>00-00</ValueOff>
    </Cheatline>
    <Cheatline>
      <Offset>4D62</Offset>
      <Section>0</Section>
      <ValueOn>E7-03</ValueOn>
      <ValueOff>00-00</ValueOff>
    </Cheatline>
  </Cheat>
</Trainer>
