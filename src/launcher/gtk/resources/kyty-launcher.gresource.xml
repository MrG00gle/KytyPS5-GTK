<?xml version="1.0" encoding="UTF-8"?>
<!-- The GTK launcher's GResource bundle (plan D8). The app icon files are byte-identical copies of
     the Qt launcher's src/launcher/icons/kyty.svg and kyty-small.svg at the head of the main branch;
     the small artwork serves every fixed size.
     The icon paths follow gtk_icon_theme_add_resource_path(): <path>/<size>/<context>/<name>.
     images/ comes from assets/ (the second source directory). -->
<gresources>
  <gresource prefix="/io/github/MrG00gle/KytyPS5_GTK">
    <file>style.css</file>
    <file>ui/additional-content-window.xml</file>
    <file>ui/binding-capture-dialog.xml</file>
    <file>ui/cheats-window.xml</file>
    <file>ui/compression-dialog.xml</file>
    <file>ui/game-menu.xml</file>
    <file>ui/game-picker-dialog.xml</file>
    <file>ui/input-mapping-window.xml</file>
    <file>ui/main-window.xml</file>
    <file>ui/settings-window.xml</file>
    <file>ui/trophy-details-dialog.xml</file>
    <file>ui/trophy-overview-window.xml</file>
    <file>ui/trophy-window.xml</file>
    <file>ui/update-progress-window.xml</file>
    <file alias="icons/scalable/apps/io.github.MrG00gle.KytyPS5_GTK.svg">icons/io.github.MrG00gle.KytyPS5_GTK.svg</file>
    <file alias="icons/16x16/apps/io.github.MrG00gle.KytyPS5_GTK.svg">icons/io.github.MrG00gle.KytyPS5_GTK-small.svg</file>
    <file alias="icons/24x24/apps/io.github.MrG00gle.KytyPS5_GTK.svg">icons/io.github.MrG00gle.KytyPS5_GTK-small.svg</file>
    <file alias="icons/32x32/apps/io.github.MrG00gle.KytyPS5_GTK.svg">icons/io.github.MrG00gle.KytyPS5_GTK-small.svg</file>
    <file alias="icons/48x48/apps/io.github.MrG00gle.KytyPS5_GTK.svg">icons/io.github.MrG00gle.KytyPS5_GTK-small.svg</file>
    <file alias="icons/64x64/apps/io.github.MrG00gle.KytyPS5_GTK.svg">icons/io.github.MrG00gle.KytyPS5_GTK-small.svg</file>
    <file alias="icons/scalable/actions/kyty-trophy-symbolic.svg">icons/kyty-trophy-symbolic.svg</file>
    <file>images/hidden-trophy.png</file>
  </gresource>
</gresources>
