{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug launcher UI",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/_Build/vscode-clang/launcher/kyty_launcher",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/_Build/vscode-clang/launcher",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb"
        },
        {
            "name": "Debug kyty_emulator",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/_Build/vscode-clang/kyty_emulator",
            "args": [
                "--game", "${userHome}/Games/PPSA07429",
                "--printf-direction", "File",
                "--graphics-debug-dump"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/_Build/vscode-clang",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Pass Kyty's internal signals to its handlers",
                    "text": "handle SIG37 SIGSEGV SIGBUS SIGILL nostop noprint pass",
                    "ignoreFailures": false
                }
            ]
        },
        {
            "name": "Attach to running kyty_emulator",
            "type": "cppdbg",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Pass Kyty's internal signals to its handlers",
                    "text": "handle SIG37 SIGSEGV SIGBUS SIGILL nostop noprint pass",
                    "ignoreFailures": false
                }
            ]
        }
    ]
}
